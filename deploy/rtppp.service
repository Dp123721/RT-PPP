[Unit]
Description=RT-PPP headless realtime service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rtppp
Group=rtppp
WorkingDirectory=/opt/rtppp
ExecStart=/opt/rtppp/build/linux/bin/RT-PPP --headless --config /etc/rtppp/rtppp_settings.ini
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
